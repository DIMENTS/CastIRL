<resources>
    <style name="Theme.CastIRL" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <style name="Theme.CastIRL.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#0F4234</item>
        <item name="windowSplashScreenIconBackgroundColor">#0F4234</item>
        <item name="postSplashScreenTheme">@style/Theme.CastIRL</item>
    </style>
</resources>
